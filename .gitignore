cat > .gitignore <<'EOF'
# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local env and secrets
.env
.env.*
*.pem

# Node
node_modules/
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
EOF

*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl
tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.DS_Store
*.swp
*.swo
*~
.idea/
*.iml
.vscode/
